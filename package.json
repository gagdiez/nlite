{
  "name": "nlite",
  "version": "1.0.0",
  "type": "module",
  "description": "Simple CLI for interacting with NEAR Protocol",
  "main": "dist/src/cli.js",
  "bin": {
    "nlite": "bin/nlite.js"
  },
  "scripts": {
    "pretest": "rm -rf tmp-project",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run test:unit && bash ./test/index.sh",
    "test:unit": "npm run build && node --test test/*.test.mjs",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "start": "node dist/src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gagdiez/nlite.git"
  },
  "author": "Guille",
  "license": "(MIT AND Apache-2.0)",
  "bugs": {
    "url": "https://github.com/gagdiez/nlite/issues"
  },
  "homepage": "https://github.com/gagdiez/nlite#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "near-api-js": "^7.4.0",
    "yargs": "^18.2.0"
  },
  "keywords": [
    "near"
  ],
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.0.0"
  }
}
